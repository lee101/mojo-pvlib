comptime NUM_PEREZ_MODELS = 10

def perez_coefficients(model: Int, f1: F64, f2: F64):
    """F1 and F2 coefficient rows for one of the Perez coefficient sets."""
    if model == 0:
        for j in range(3):
            f1.unsafe_store(0 * 3 + j, nan_())
            f2.unsafe_store(0 * 3 + j, nan_())
        f1.unsafe_store(1 * 3 + 0, -0.008)
